# WhatsApp Integration (Meta Cloud API)
WHATSAPP_API_KEY=your-whatsapp-api-token
WHATSAPP_PHONE_ID=your-phone-number-id

# Admin Panel URL
ADMIN_PANEL_URL=http://localhost:3000/admin
